<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PizzaApp.ViewModels"
             x:Class="PizzaApp.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#141414">
        <Border Background="#1c1c1c" 
                BorderBrush="#2d2d2d" 
                BorderThickness="1" 
                CornerRadius="8" 
                Width="320" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="25">
            
            <StackPanel Spacing="15" HorizontalAlignment="Stretch">
                
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🍕 PIZZA AUTOMATION" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#ff9f43" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Employee Terminal Login" 
                               FontSize="12" 
                               Foreground="#888888" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Staff Operational Role:" Foreground="#a0a0a0" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Roles}" 
                              SelectedItem="{Binding SelectedRole}" 
                              HorizontalAlignment="Stretch" 
                              Background="#252525" 
                              Foreground="White"
                              Padding="10"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Security Access PIN:" Foreground="#a0a0a0" FontSize="12"/>
                    <TextBox Text="{Binding PinCode}"
                             PasswordChar="*" 
                             MaxLength="4"
                             PlaceholderText="PIN Code"
                             FontSize="22" 
                             HorizontalContentAlignment="Center"
                             Foreground="White"
                             Background="#252525"
                             BorderBrush="#444444"
                             CaretBrush="White"
                             Padding="6"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Button Content="Login" 
                        Command="{Binding LoginCommand}"
                        Background="#ff9f43" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="16"
                        Padding="10"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        CornerRadius="5"
                        Margin="0,10,0,0"/>

                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#ff4d4d" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           FontWeight="Medium"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>