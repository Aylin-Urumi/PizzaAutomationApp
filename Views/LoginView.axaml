<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PizzaApp.ViewModels"
             x:Class="PizzaApp.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <Grid Background="#1e1e1e">
        <Border Background="#2d2d2d" 
                CornerRadius="10" 
                Padding="30" 
                Width="350" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                BoxShadow="0 4 20 0 #000000">
            
            <StackPanel Spacing="20">
                <TextBlock Text="🍕 PIZZA SYSTEM" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="#ff9f43" 
                           HorizontalAlignment="Center"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Select Staff Role:" Foreground="#a0a0a0" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Enter 4-Digit PIN:" Foreground="#a0a0a0" FontSize="12"/>
                    <TextBox Text="{Binding PinCode}"
                             PasswordChar="*" 
                             MaxLength="4"
                             Watermark="PIN Code"
                             FontSize="22" 
                             HorizontalContentAlignment="Center"/>
                </StackPanel>

                <Button Content="Login" 
                        Command="{Binding LoginCommand}"
                        Background="#ff9f43" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="16"
                        Padding="10"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        CornerRadius="5"/>

                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#ff4d4d" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>