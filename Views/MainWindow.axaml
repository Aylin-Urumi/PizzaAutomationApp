<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PizzaApp.ViewModels"
        xmlns:views="using:PizzaApp.Views"
        x:Class="PizzaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pizza Restaurant Automation"
        WindowStartupLocation="CenterScreen"
        Width="900" Height="600">

    <!-- This section maps your ViewModels to their corresponding UI views -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CashierViewModel">
            <views:CashierView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ManagerViewModel">
            <views:ManagerView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ChefViewModel">
            <views:ChefView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DeliveryViewModel">
            <views:DeliveryView/>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentPage}" x:CompileBindings="True" />

</Window>