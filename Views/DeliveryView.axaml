<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PizzaApp.ViewModels"
             xmlns:models="using:PizzaApp.Models"
             x:Class="PizzaApp.Views.DeliveryView"
             x:DataType="vm:DeliveryViewModel">
    
    <!-- REMOVED: Padding="20" from here so it compiles cleanly -->
    <Grid RowDefinitions="Auto, *" Background="#141414">
        
        <!-- Header Controls (Added a 20-pixel margin around it) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="20 20 20 20">
            <TextBlock Text="🛵 DELIVERY DISPATCH LOG BOARD" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="🔄 Refresh Map" Command="{Binding LoadDeliveriesCommand}" Background="#222222" Foreground="White" Margin="0 0 10 0" Padding="15 8" CornerRadius="5"/>
            <Button Grid.Column="2" Content="Log Out" Command="{Binding LogoutCommand}" Background="#ff4d4d" Foreground="White" Padding="15 8" CornerRadius="5"/>
        </Grid>

        <!-- Driver Content List (Added 20-pixel padding directly inside the scroll viewer) -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <ItemsControl ItemsSource="{Binding DeliveryOrders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Border Background="#1e1e1e" CornerRadius="10" Padding="20" Margin="0 0 0 15" BoxShadow="0 4 10 0 #000000">
                            <Grid ColumnDefinitions="*, 200">
                                <!-- Address Left Pane -->
                                <!-- Address & Contact Pane -->
                                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto, Auto">
                                        <TextBlock Text="{Binding Id, StringFormat='Delivery Ticket #{0}'}" FontSize="18" FontWeight="Bold" Foreground="#4cd137"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderDate, StringFormat=' placed at {0:HH:mm}'}" Foreground="#777777" FontSize="13" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CustomerName, StringFormat='👤 Name: {0}'}" Foreground="White" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding PhoneNumber, StringFormat='📞 Phone: {0}'}" Foreground="#a0a0a0" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0 2 0 0">
                                        <TextBlock Text="📍 Address:" Foreground="#ff9f43" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding DeliveryAddress}" Foreground="White" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Clear Action Right Button -->
                                <Button Grid.Column="1" Content="🏁 Mark Delivered" 
                                        Command="{Binding $parent[UserControl].((vm:DeliveryViewModel)DataContext).MarkAsDeliveredCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#0984e3" Foreground="White" FontWeight="Bold" FontSize="15" Padding="12"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" CornerRadius="6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>