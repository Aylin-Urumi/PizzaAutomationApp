<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PizzaApp.ViewModels"
             xmlns:models="using:PizzaApp.Models"
             x:Class="PizzaApp.Views.DeliveryView"
             x:DataType="vm:DeliveryViewModel">

    <Border Background="#141414" Padding="20">
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="{Binding CurrentDeliveryWorker.Username, StringFormat='🚚 COURIER CONSOLE: {0}'}" 
                               FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="🔄 Refresh My Run" Command="{Binding LoadMyDeliveriesCommand}" Background="#2d2d2d" Foreground="White" Padding="10,5" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="Log Out" Command="{Binding LogoutCommand}" Background="#ff4d4d" Foreground="White" Padding="14,7" CornerRadius="5"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="{Binding DeliveryStatusMessage}" Foreground="#ff9f43" FontSize="13" Margin="0,0,0,10" HorizontalAlignment="Center" FontWeight="Medium"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MyDeliveries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Order">
                                <Border Background="#1c1c1c" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Width="300" Margin="0,0,15,15" Padding="15">
                                    <Grid RowDefinitions="Auto, *, Auto, Auto">
                                        
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Id, StringFormat='Order #{0}'}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                            <Border Background="#2d2d2d" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding Status}" Foreground="#ff9f43" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding CustomerName, StringFormat='👤 Name: {0}'}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding PhoneNumber, StringFormat='📞 Phone: {0}'}" Foreground="#a0a0a0" FontSize="12"/>
                                            <TextBlock Text="{Binding DeliveryAddress, StringFormat='📍 Addr: {0}'}" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap" MaxHeight="40"/>
                                            
                                            <Separator Background="#2d2d2d" Margin="0,5"/>
                                            
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:OrderItem">
                                                        <TextBlock Foreground="#aaaaaa" FontSize="11" Margin="0,2" TextWrapping="Wrap">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="• {0}x {1} ({2}, {3})">
                                                                    <Binding Path="Quantity"/>
                                                                    <Binding Path="Product.Name"/>
                                                                    <Binding Path="Size"/>
                                                                    <Binding Path="Crust"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                            <TextBlock Text="Collect Payment:" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='${0:F2}'}" Foreground="#4cd137" FontWeight="Bold" FontSize="15"/>
                                        </Grid>

                                        <Button Grid.Row="3" 
                                                Command="{Binding $parent[UserControl].((vm:DeliveryViewModel)DataContext).AdvanceOrderStatusCommand}" 
                                                CommandParameter="{Binding}"
                                                Background="#ff9f43" Foreground="White" FontWeight="Bold" FontSize="12" Padding="8" 
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4">
                                            <Button.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Content" Value="🟢 Depart on Delivery Run"/>
                                                </Style>
                                                <Style Selector="Button[Content=OutForDelivery]">
                                                    <Setter Property="Content" Value="🏁 Confirm Delivered &amp; Paid"/>
                                                    <Setter Property="Background" Value="#4cd137"/>
                                                </Style>
                                            </Button.Styles>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>