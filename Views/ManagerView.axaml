<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PizzaApp.ViewModels"
             xmlns:models="using:PizzaApp.Models"
             x:Class="PizzaApp.Views.ManagerView"
             x:DataType="vm:ManagerViewModel">

    <Border Background="#141414" Padding="20">
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="📊 MANAGER ADMINISTRATIVE OPERATIONS" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="🔄 Refresh Data" Command="{Binding LoadDashboardDataCommand}" Background="#2d2d2d" Foreground="White" Padding="10,5" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Log Out" Command="{Binding LogoutCommand}" Background="#ff4d4d" Foreground="White" Padding="14,7" CornerRadius="5"/>
            </Grid>

            <TabControl Grid.Row="1">
                
                <TabItem Header="Sales Metrics" Foreground="White" FontSize="14">
                    <Grid RowDefinitions="Auto, *" Margin="0,15,0,0">
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                            
                            <Border Background="#1e1e1e" CornerRadius="8" Padding="15" Width="195" BorderBrush="#2d2d2d" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Gross Sales Total" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalSales, StringFormat='${0:F2}'}" Foreground="#00d2d3" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1e1e1e" CornerRadius="8" Padding="15" Width="195" BorderBrush="#4cd137" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="💰 Today's Revenue" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBlock Text="{Binding DailyRevenue, StringFormat='${0:F2}'}" Foreground="#4cd137" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1e1e1e" CornerRadius="8" Padding="15" Width="195" BorderBrush="#ff9f43" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="📈 Monthly Revenue" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBlock Text="{Binding MonthlyRevenue, StringFormat='${0:F2}'}" Foreground="#ff9f43" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1e1e1e" CornerRadius="8" Padding="15" Width="195" BorderBrush="#2d2d2d" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Total Orders Logged" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalOrdersCount}" Foreground="#ffffff" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1c1c1c" CornerRadius="8" Padding="15" BorderBrush="#2d2d2d" BorderThickness="1">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <TextBlock Grid.Row="0" Text="Recent Orders History" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,10,10"/>
                                
                                <!-- 🌟 NEW: Column Label Headings for Manager Tracking Clarity -->
                                <!-- Change Padding to Margin to keep Avalonia happy 🌟 -->
                                <Grid Grid.Row="1" ColumnDefinitions="60, 110, *, 105, 105, 105, 100, 90" Margin="5,5,5,5">
                                    <TextBlock Grid.Column="0" Text="ID" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="TIMESTAMP" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="CUSTOMER" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="CASHIER" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="4" Text="CHEF" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="5" Text="DRIVER" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="6" Text="STATUS" Foreground="#666666" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="7" Text="TOTAL" Foreground="#666666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ListBox Grid.Row="2" ItemsSource="{Binding RecentOrders}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Order">
                                            <Border BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="5,8">
                                                <!-- 🌟 FIXED: expanded mapping configuration to print relational assignments safely -->
                                                <Grid ColumnDefinitions="60, 110, *, 105, 105, 105, 100, 90">
                                                    <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}" Foreground="#ff9f43" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OrderDate, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="#888888"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CustomerName}" Foreground="White"/>
                                                    
                                                    <!-- Accountability Targets Display -->
                                                    <TextBlock Grid.Column="3" Text="{Binding CreatedByCashier.Username, FallbackValue='-'}" Foreground="#00d2d3" FontSize="13"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding AssignedChef.Username, FallbackValue='-'}" Foreground="#ff9f43" FontSize="13"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding AssignedDriver.Username, FallbackValue='-'}" Foreground="#ffda79" FontSize="13"/>
                                                    
                                                    <TextBlock Grid.Column="6" Text="{Binding Status}" Foreground="#cccccc"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding TotalAmount, StringFormat='${0:F2}'}" Foreground="#4cd137" HorizontalAlignment="Right" FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Staff Management" Foreground="White" FontSize="14">
                    <Grid ColumnDefinitions="*, 350" Margin="0,15,0,0">
                        
                        <Border Grid.Column="0" Background="#1c1c1c" CornerRadius="8" Padding="15" Margin="0,0,15,0" BorderBrush="#2d2d2d" BorderThickness="1">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Active Employee Login Accounts" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                
                                <ListBox Grid.Row="1" ItemsSource="{Binding Workers}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:User">
                                            <Border BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid ColumnDefinitions="*, 120, Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="👤" Foreground="#ff9f43"/>
                                                        <TextBlock Text="{Binding Username}" Foreground="White" FontWeight="Medium" FontSize="14"/>
                                                    </StackPanel>
                                                    
                                                    <Border Grid.Column="1" Background="#2d2d2d" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Role}" Foreground="#ff9f43" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    
                                                    <Button Grid.Column="2" Content="Revoke Access" 
                                                            Command="{Binding $parent[UserControl].((vm:ManagerViewModel)DataContext).DeleteWorkerCommand}" CommandParameter="{Binding}"
                                                            Background="#3a1c1c" Foreground="#ff4d4d" FontSize="12" Padding="10,5" CornerRadius="4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#1e1e1e" CornerRadius="8" Padding="15" BorderBrush="#2d2d2d" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Provision New Worker Account" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                <Separator Background="#2d2d2d"/>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Username ID:" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBox Text="{Binding NewWorkerUsername}" 
                                             Foreground="White"
                                             Background="#252525" 
                                             BorderBrush="#444444" 
                                             CaretBrush="White" 
                                             Padding="8"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Access PIN / Pincode:" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBox Text="{Binding NewWorkerPassword}" 
                                             Foreground="White"
                                             Background="#252525" 
                                             BorderBrush="#444444" 
                                             CaretBrush="White" 
                                             Padding="8"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Operational Workspace Role:" Foreground="#a0a0a0" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewWorkerRole}" HorizontalAlignment="Stretch" Background="#141414" Foreground="White"/>
                                </StackPanel>

                                <Button Content="➕ Register Employee" Command="{Binding AddWorkerCommand}" Background="#ff9f43" Foreground="White" FontWeight="Bold" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="5" Margin="0,10,0,0"/>
                                
                                <TextBlock Text="{Binding ManagerStatusMessage}" Foreground="#ff9f43" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Customer Feedback" Foreground="White" FontSize="14">
                    <Border Margin="0,15,0,0" Background="#1c1c1c" CornerRadius="8" Padding="15" BorderBrush="#2d2d2d" BorderThickness="1">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Live Customer Experience Reports Log" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            
                            <ListBox Grid.Row="1" ItemsSource="{Binding Feedbacks}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerFeedback">
                                        <Border Background="#222222" CornerRadius="6" Margin="0,0,0,10" Padding="15" BorderBrush="#2d2d2d" BorderThickness="1">
                                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                                
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding CustomerName, StringFormat='👤 Client: {0}'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding DateSubmitted, StringFormat='📅 Date Logged: {0:g}'}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Grid.Row="0" Grid.Column="1" Content="Clear Entry" 
                                                        Command="{Binding $parent[UserControl].((vm:ManagerViewModel)DataContext).DeleteFeedbackCommand}" CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#ff4d4d" FontSize="11" Padding="5"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Details}" Foreground="#cccccc" FontSize="13" TextWrapping="Wrap" Margin="5,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Inventory Line" Foreground="White" FontSize="14">
                    <Grid ColumnDefinitions="*, 350" Margin="0,15,0,0">
                        
                        <Border Grid.Column="0" Background="#1c1c1c" CornerRadius="8" Padding="15" Margin="0,0,15,0" BorderBrush="#2d2d2d" BorderThickness="1">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Raw Materials &amp; Ingredient Stock Levels" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                
                                <ListBox Grid.Row="1" ItemsSource="{Binding Ingredients}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Ingredient">
                                            <Border BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" Padding="5,10">
                                                <Grid ColumnDefinitions="*, 150, 100">
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="{Binding Unit}" Foreground="#888888" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#1f2d1f" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="📦 Managed" Foreground="#4cd137" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#1e1e1e" CornerRadius="8" Padding="15" BorderBrush="#2d2d2d" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Warehouse Supply Inflow" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                <Separator Background="#2d2d2d"/>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Select Ingredient Item:" Foreground="#a0a0a0" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}" HorizontalAlignment="Stretch" Background="#141414" Foreground="White">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Ingredient">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Restock Amount (Volume):" Foreground="#a0a0a0" FontSize="12"/>
                                    <TextBox Text="{Binding RestockAmountText}" 
                                             Foreground="White"
                                             Background="#252525" 
                                             BorderBrush="#444444" 
                                             CaretBrush="White" 
                                             Padding="8"
                                             PlaceholderText="e.g. 5000"/>
                                </StackPanel>

                                <Button Content="📦 Execute Restock Order" Command="{Binding RestockIngredientCommand}" Background="#ff9f43" Foreground="White" FontWeight="Bold" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="5" Margin="0,10,0,0"/>
                                
                                <TextBlock Text="{Binding ManagerStatusMessage}" Foreground="#ff9f43" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>